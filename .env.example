# ── Edge function (Supabase secrets — set with `supabase secrets set KEY=value`) ──
# Never shipped to the browser. Only the edge function reads it.
ANTHROPIC_API_KEY=
# Model for extraction, pattern discovery, find_people and the rescue agent (Sonnet-class).
CF_MODEL_EXTRACT=claude-sonnet-5-5
# Model for domain resolution. Defaults to CF_MODEL_EXTRACT; a Haiku-class id is cheaper.
CF_MODEL_DOMAIN=
# Model for the decision layer (classify / choose / score) — Haiku-class.
CF_MODEL_CLASSIFY=claude-haiku-4-5
# Effort for CF_MODEL_EXTRACT stages (low | medium | high). Empty = model default.
CF_EFFORT=low
# Server-side refusal fallback (Claude API only). "default" or empty to disable.
CF_FALLBACKS=default
# Hard cap on web searches the pipeline spends per new company (domain + pattern).
CF_MAX_SEARCHES_PER_COMPANY=4
# Calls per minute per session (and per IP). 429 after that.
CF_RATE_LIMIT_PER_MIN=30
# Calls per day across all sessions (needs the cf_usage table). 0 = unlimited.
CF_DAILY_LIMIT=2000
# TTL for the server-side domain → patterns cache.
CF_CACHE_TTL_DAYS=30
# Comma-separated origins allowed by CORS. "*" for local dev only.
CF_ALLOWED_ORIGINS=*
# Optional shared token; when set, requests must send it as `x-cf-token`.
CF_ACCESS_TOKEN=

# ── Web app (packages/web/.env) ──
# URL of the deployed `pipeline` function, e.g. https://<ref>.supabase.co/functions/v1/pipeline
VITE_EDGE_URL=
# Must match CF_ACCESS_TOKEN when that is set.
VITE_ACCESS_TOKEN=

# ── Scripts (smoke / record) — same values as the web app ──
CF_EDGE_URL=
CF_ACCESS_TOKEN_CLIENT=
